library(betareg)
library(car)
library(glmnet)
library(emmeans)
library(mgcv)
## ============================================================================================================ ##
## Analzye R^2
#--------------
## Load data ##
#--------------
r2_results <- read.csv("Data/Models_R2.csv", sep=";", row.names = NULL)
# Order Diversity: TD < FD < PD
r2_results$Diversity <- factor(r2_results$Diversity, levels = c("TD", "FD", "PD"), ordered = TRUE)
# Change q (Hill number) to factor
r2_results$q <- factor(r2_results$q, levels = c(0, 1, 2))
r2_results$Threshold <- factor(r2_results$Threshold, levels = c(0.5, 0.9))
# Add Model_Scope (global vs targeted)
r2_results$Model_Scope <- ifelse(r2_results$Model == "BirdNET", "global", "local")
r2_results$Model_Scope <- factor(r2_results$Model_Scope, levels = c("global", "local"))
# Fit beta regression model
model <- betareg(R2 ~ Threshold * Model_Scope + Diversity + q + Species_identified, data = r2_results)
summary(model)
rm(list=ls(all=TRUE))
Sys.setenv(LANG = "en")
